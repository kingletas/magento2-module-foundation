# Static analysis needs the Magento classes on the autoloader, so this is only
# runnable where `composer install` has resolved magento/framework. The CI job
# that runs it is gated on those credentials being present rather than being
# allowed to pass vacuously.
parameters:
    level: 6
    # Registers the on-demand generator, so a Factory that only exists
    # after `setup:di:compile` resolves here too.
    bootstrapFiles:
        - Test/generated-classes.php
    paths:
        - Api
        - Model
        - Ui
    excludePaths:
        - Test/*
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Image::init() takes an untyped $product and documents it as the
        # concrete Product; a repository hands back the interface.
        -
            message: '#Parameter \#1 \$product of method Magento\\Catalog\\Helper\\Image::init\(\) expects Magento\\Catalog\\Model\\Product#'
            path: Model/Catalog/ProductImageUrlResolver.php
        # Collection::getItems() documents DataObject[] and setItems() wants
        # ExtensibleDataInterface[]; every core repository bridges the two.
        -
            message: '#Parameter \#1 \$items of method Magento\\Framework\\Api\\SearchResultsInterface::setItems\(\) expects#'
            path: Model/Repository/SearchResultBuilder.php
