<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Kingletas\Foundation\Api\TokenGeneratorInterface"
                type="Kingletas\Foundation\Model\Security\TokenGenerator"/>
    <preference for="Kingletas\Foundation\Api\RegistryInterface"
                type="Kingletas\Foundation\Model\Registry"/>
    <preference for="Kingletas\Foundation\Api\MessageQueueEnvelopeInterface"
                type="Kingletas\Foundation\Model\MessageQueue\Envelope"/>
    <preference for="Kingletas\Foundation\Api\ProductImageUrlResolverInterface"
                type="Kingletas\Foundation\Model\Catalog\ProductImageUrlResolver"/>
    <preference for="Kingletas\Foundation\Api\ConfigurableParentSkuResolverInterface"
                type="Kingletas\Foundation\Model\Catalog\ConfigurableParentSkuResolver"/>

    <!--
        CacheKeyBuilderInterface is intentionally left without a global
        preference.
    -->
    <virtualType name="Kingletas\Foundation\Model\Cache\ConfigurableParentSkuCacheKeyBuilder"
                 type="Kingletas\Foundation\Model\Cache\CacheKeyBuilder">
        <arguments>
            <argument name="prefix" xsi:type="string">kingletas_cfg_parent_sku</argument>
            <argument name="tags" xsi:type="array">
                <item name="catalog_product" xsi:type="const">Magento\Catalog\Model\Product::CACHE_TAG</item>
            </argument>
            <argument name="lifetime" xsi:type="number">86400</argument>
        </arguments>
    </virtualType>

    <type name="Kingletas\Foundation\Model\Catalog\ConfigurableParentSkuResolver">
        <arguments>
            <argument name="cacheKeyBuilder" xsi:type="object">Kingletas\Foundation\Model\Cache\ConfigurableParentSkuCacheKeyBuilder</argument>
        </arguments>
    </type>

    <!-- Foundation's own log channel, for consumers that have no logger of their own. -->
    <virtualType name="Kingletas\Foundation\Logger\Handler" type="Kingletas\Logger\Handler">
        <arguments>
            <argument name="fileName" xsi:type="string">foundation.log</argument>
            <argument name="subDirectory" xsi:type="string">kingletas</argument>
        </arguments>
    </virtualType>
    <virtualType name="Kingletas\Foundation\Logger" type="Kingletas\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">kingletas_foundation</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Kingletas\Foundation\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

</config>
